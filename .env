# Copy this file to .env and add your own key. Never submit .env.
LLM_PROVIDER=gemini
GEMINI_API_KEY=enter your key here
LLM_MODEL=gemini-3.6-flash

# For a no-key demo, set this to true:
# MOCK_MODE=true

# Ollama alternative (normally needs no API key):
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=llama3.2
